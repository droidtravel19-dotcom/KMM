# AI triage (omit to fall back to the built-in keyword classifier)
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5

# Firm details used in replies and digests
FIRM_NAME=Kahiga Mukami & Macharia Advocates
FIRM_PHONE=
REPLY_FROM=intake@example.com
DIGEST_TO=partners@example.com

# Auto-replies are only SENT when this is "true"; otherwise they are logged and stored as drafts
SEND_REPLIES=false

# SMTP (outbound replies + digest)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IMAP (optional: poll a shared inbox for enquiries)
IMAP_HOST=outlook.office365.com
IMAP_USER=
IMAP_PASSWORD=

# Protects POST /intake (send as header X-Intake-Token). Leave empty to disable.
INTAKE_TOKEN=
DB_PATH=intake.db

# WhatsApp Business Cloud API (Meta). Webhook: https://<host>/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
